#!/bin/sh
# Refuse to commit personal data.
#
#   git config core.hooksPath hooks
#
# .gitignore already keeps your material out of the way. This is the second
# lock, for the evening you reach for `git add -f` or `git add -A` after
# renaming something: it blocks your sources, your real profile and any
# application folder that is not one of the two examples shipped with the
# template - the folder that holds a real offer, your reframed bullets and a
# PDF with your name and phone number on it.

staged=$(git diff --cached --name-only)

blocked=$(printf '%s\n' "$staged" \
    | grep -E '^(sources/|profile/profile\.yaml$|applications/)' \
    | grep -v -E '^sources/README\.md$' \
    | grep -v -E '^applications/(orbital-freight|quayside-systems)/')

if [ -n "$blocked" ]; then
    echo "pre-commit: refusing to commit personal data:"
    printf '  %s\n' $blocked
    echo
    echo "These files are yours, not the repository's."
    echo "If you really mean it: git commit --no-verify"
    exit 1
fi
exit 0
