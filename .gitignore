# --- your data, never committed ------------------------------------
sources/*
!sources/README.md
profile/profile.yaml
profile/*.local.yaml

# --- your applications ----------------------------------------------
# Default deny. An application folder holds a real job offer, your reframed
# bullets and a PDF with your name and phone number on it - so a folder you
# create here stays local, and you have to mean it to commit one.
# The two example folders are the exception: they are part of the template.
applications/*
!applications/orbital-freight/
!applications/quayside-systems/

# --- generated PDFs --------------------------------------------------
# The example PDFs are committed as proof the build works; everything else
# you generate stays local.
*.pdf
!applications/orbital-freight/*.pdf
!applications/quayside-systems/*.pdf

# --- python ----------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# --- editors / os ----------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
